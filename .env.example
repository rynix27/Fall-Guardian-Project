# Fall Guardian configuration template. Copy to .env and fill in. Never commit .env.
# Only variables listed here are read by the code in this repository.

# Bearer token required by the Alexa HTTP API for /execute_tool and /emergencies/:id.
# If unset, those endpoints return 503 (fail closed). Generate a long random value:
#   python3 -c 'import secrets;print(secrets.token_urlsafe(32))'
FG_API_TOKEN=

# Alexa HTTP API port (development only; use TLS in front of it for any real deployment)
ALEXA_MCP_PORT=3000

# SQLite database file (default: fall_guardian.db in the working directory)
FALL_GUARDIAN_DB=fall_guardian.db

# Comma-separated emergency contacts, used only in INTEGRATION mode. Placeholders use reserved 555 numbers.
EMERGENCY_CONTACTS=+1-555-0100,+1-555-0101

# DynamoDB table name used by the Lambda handler (aws/fall_event_handler.py)
FALLS_TABLE=fall-guardian-events

# Legacy Bedrock module (alexa_mcp_server). Without a key, only a labelled placeholder is returned.
ANTHROPIC_API_KEY=

# Log level for the Node.js components: DEBUG, INFO, WARN, ERROR
LOG_LEVEL=INFO
